{
  "name": "@stremio-addon-manager/translated-subtitles",
  "version": "1.0.0",
  "private": true,
  "description": "Stremio subtitles addon: OpenSubtitles v3 proxy + local LLM translation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/model-catalog.d.ts",
      "import": "./dist/model-catalog.js",
      "default": "./dist/model-catalog.js"
    },
    "./env-keys": {
      "types": "./dist/env-keys.d.ts",
      "import": "./dist/env-keys.js",
      "default": "./dist/env-keys.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "models",
    "mt-sidecar"
  ],
  "bin": {
    "stremio-translated-subtitles": "./bin/server.js"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "start": "node dist/main.js",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts --ignore-pattern \"**/__tests__/**\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5"
  }
}