{
  "name": "@stremio-addon-manager/addon-server",
  "version": "1.0.0",
  "private": true,
  "description": "Stremio addon HTTP server (streams, management UI, local library)",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "bin",
    "management",
    "landing.html"
  ],
  "bin": {
    "stremio-addon-server": "./bin/server.js"
  },
  "scripts": {
    "build": "tsc --build && node ./scripts/copy-management-assets.mjs",
    "dev": "tsc --build --watch",
    "start": "node dist/index.js",
    "clean": "rimraf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "stremio-addon-sdk": "^1.6.10",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "node-cache": "^5.1.2",
    "express-rate-limit": "^7.1.5",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.5"
  }
}